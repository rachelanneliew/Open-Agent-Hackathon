# Copy to dispute-demo/.env.local and set a private password before starting Postgres.
# This password belongs to the separate project database loader, not your Zetaris login.
DISPUTE_DB_PASSWORD=
DISPUTE_DB_PORT=55432
# Restricted LOGIN granted only dispute_action_writer after migrations 001/002.
# Never use the loader/admin or Zetaris metastore credentials for this DSN.
DISPUTE_ACTION_DSN=

# Nightshift: provider API keys go in the app's Setup > Providers.
# Save its separate runtime token with: python3 integration/check_nightshift.py --set-token
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
